#!/usr/bin/env bash
# Rofi power menu — nightgrid.
set -uo pipefail

theme="$HOME/.config/rofi/powermenu.rasi"

chosen=$(printf '%s\n' '󰐥' '󰜉' '󰍃' '󰌾' \
    | rofi -dmenu -i -theme "$theme" -p "" -no-custom -format i)

case "$chosen" in
    0) systemctl poweroff ;;
    1) systemctl reboot ;;
    2) i3-msg exit ;;
    3) exec "$HOME/.local/bin/lockscreen" ;;
    *) exit 0 ;;
esac
