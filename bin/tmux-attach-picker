#!/usr/bin/env bash
# Rofi picker: lists sessions across EVERY tmux server (every workspace's
# "-L wsN" socket), lets you pick one, opens it in a new Kitty window
# attached to the correct server.
set -uo pipefail

SOCKET_DIR="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
[[ -d "$SOCKET_DIR" ]] || exit 0

entries=()
for sock in "$SOCKET_DIR"/kitty-*; do
    [[ -S "$sock" ]] || continue
    label="$(basename "$sock")"
    while IFS= read -r line; do
        entries+=("${label} :: ${line}")
    done < <(tmux -L "$label" list-sessions -F '#{session_name}  (#{session_windows} windows, #{t:session_created})' 2>/dev/null)
done

[[ ${#entries[@]} -gt 0 ]] || { notify-send "tmux" "No old sessions to restore" 2>/dev/null; exit 0; }

chosen="$(printf '%s\n' "${entries[@]}" | rofi -dmenu -i -p "Restore session" \
    -mesg "Enter: open   Alt+d: kill session   Alt+shift+d: kill ALL" \
    -kb-custom-1 "Alt+d" \
    -kb-custom-2 "Alt+shift+d")"
rc=$?
[[ -n "$chosen" ]] || exit 0

sock="${chosen%% :: *}"
rest="${chosen#* :: }"
session="${rest%%  *}"

if [[ $rc -eq 11 ]]; then
    confirm="$(printf 'No\nYes' | rofi -dmenu -i -p "Kill ALL sessions across every window?")"
    if [[ "$confirm" == "Yes" ]]; then
        for sock_all in "$SOCKET_DIR"/kitty-*; do
            [[ -S "$sock_all" ]] || continue
            tmux -L "$(basename "$sock_all")" kill-server 2>/dev/null
        done
        rm -f "$SOCKET_DIR"/kitty-*
        notify-send "tmux" "All sessions killed" 2>/dev/null
    fi
    exit 0
fi

if [[ $rc -eq 10 ]]; then
    tmux -L "$sock" kill-session -t "$session" 2>/dev/null
    notify-send "tmux" "Session ${session} (${sock}) killed" 2>/dev/null
    exit 0
fi

kitty zsh -i -c "tmux -L '$sock' attach-session -t '$session'" &
