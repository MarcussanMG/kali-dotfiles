# ═══════════════════════════════════════════════════════════════════════
#  i3 — Kali OSCP Workstation
#  Theme: nightgrid (black / green)
#  Every keybinding from the previous configuration is preserved verbatim.
#  New bindings are grouped at the bottom under "Additions".
# ═══════════════════════════════════════════════════════════════════════

set $mod Mod4

# ───────────────────────────────────────────────────────────────────────
#  Palette — nightgrid
# ───────────────────────────────────────────────────────────────────────
set $bg        #05070a
set $bg_soft   #090e0c
set $bg_panel  #0d1410
set $green     #22c55e
set $green_hi  #4ade80
set $green_dim #166534
set $green_sel #133320
set $fg        #d1fae5
set $fg_dim    #86efac
set $gray      #4b5e54
set $gray_hi   #7c8b84
set $red       #f87171
set $yellow    #fbbf24

# ───────────────────────────────────────────────────────────────────────
#  Typography
# ───────────────────────────────────────────────────────────────────────
font pango:JetBrainsMono Nerd Font Mono 10

# ───────────────────────────────────────────────────────────────────────
#  Autostart
# ───────────────────────────────────────────────────────────────────────
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.local/bin/lockscreen
exec --no-startup-id nm-applet
exec_always --no-startup-id feh --bg-fill ~/.dotfiles/wallpapers/nightgrid.png
exec_always --no-startup-id ~/.local/bin/start-picom
exec --no-startup-id ~/.local/bin/sync-notes.sh

# ───────────────────────────────────────────────────────────────────────
#  Audio keys
# ───────────────────────────────────────────────────────────────────────
set $refresh_i3blocks pkill -RTMIN+10 i3blocks
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3blocks
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3blocks
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3blocks

# ───────────────────────────────────────────────────────────────────────
#  Mouse behaviour
# ───────────────────────────────────────────────────────────────────────
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no

# ───────────────────────────────────────────────────────────────────────
#  Applications
# ───────────────────────────────────────────────────────────────────────
bindsym $mod+Return exec kitty
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+x exec --no-startup-id ~/.local/bin/powermenu
bindsym $mod+Shift+b exec --no-startup-id burpsuite
bindsym $mod+Shift+f exec --no-startup-id firefox-esr
bindsym $mod+Shift+l exec --no-startup-id ~/.local/bin/lockscreen

# ───────────────────────────────────────────────────────────────────────
#  Window management
# ───────────────────────────────────────────────────────────────────────
bindsym $mod+Shift+q kill

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ───────────────────────────────────────────────────────────────────────
#  Workspaces
#  Deliberately unnamed: no workspace is tied to a fixed application.
#  To use icons instead, comment the block below and uncomment the next.
# ───────────────────────────────────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# set $ws1  "1 "
# set $ws2  "2 "
# set $ws3  "3 "
# set $ws4  "4 "
# set $ws5  "5 "
# set $ws6  "6 "
# set $ws7  "7 "
# set $ws8  "8 "
# set $ws9  "9 "
# set $ws10 "10 "

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ───────────────────────────────────────────────────────────────────────
#  Session
# ───────────────────────────────────────────────────────────────────────
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# ───────────────────────────────────────────────────────────────────────
#  Resize
# ───────────────────────────────────────────────────────────────────────
mode "resize" {
        bindsym j         resize shrink width  10 px or 10 ppt
        bindsym k         resize grow   height 10 px or 10 ppt
        bindsym l         resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow   width  10 px or 10 ppt

        bindsym Left  resize shrink width  10 px or 10 ppt
        bindsym Down  resize grow   height 10 px or 10 ppt
        bindsym Up    resize shrink height 10 px or 10 ppt
        bindsym Right resize grow   width  10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

bindsym $mod+Ctrl+Shift+Left  resize shrink width  10 px or 10 ppt
bindsym $mod+Ctrl+Shift+Right resize grow   width  10 px or 10 ppt
bindsym $mod+Ctrl+Shift+Up    resize shrink height 10 px or 10 ppt
bindsym $mod+Ctrl+Shift+Down  resize grow   height 10 px or 10 ppt

# ═══════════════════════════════════════════════════════════════════════
#  Additions — new bindings, nothing above was changed
# ═══════════════════════════════════════════════════════════════════════
# Toggle the compositor and terminal opacity (exam mode: zero effects)
bindsym $mod+Shift+p exec --no-startup-id ~/.local/bin/toggle-effects
# Region screenshot to ~/screenshots and the clipboard
bindsym $mod+Shift+s exec --no-startup-id ~/.local/bin/screenshot
# Set the engagement target shown in the bar
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/set-target

# ───────────────────────────────────────────────────────────────────────
#  Appearance
# ───────────────────────────────────────────────────────────────────────
default_border         pixel 2
default_floating_border pixel 2

# Requires i3 >= 4.22 (gaps are built in). Kali rolling ships 4.23+.
gaps inner 8
gaps outer 2
smart_gaps on
smart_borders on

# class                 border     background  text      indicator  child_border
client.focused          $green     $bg_panel   $fg       $green_hi  $green
client.focused_inactive $green_dim $bg_soft    $fg_dim   $green_dim $green_dim
client.unfocused        $bg_panel  $bg         $gray_hi  $bg_panel  $bg_panel
client.urgent           $red       $red        $bg       $red       $red
client.placeholder      $bg_panel  $bg         $gray     $bg_panel  $bg_panel
client.background       $bg

# ───────────────────────────────────────────────────────────────────────
#  Floating rules
# ───────────────────────────────────────────────────────────────────────
for_window [window_role="pop-up"]      floating enable
for_window [window_role="bubble"]      floating enable
for_window [window_type="dialog"]      floating enable
for_window [class="Pavucontrol"]       floating enable, resize set 900 600
for_window [class="Nm-connection-editor"] floating enable
for_window [title="Wireshark . Preferences"] floating enable

# ───────────────────────────────────────────────────────────────────────
#  Bar
# ───────────────────────────────────────────────────────────────────────
bar {
    status_command       i3blocks
    position             top
    tray_output          primary
    separator_symbol     " "
    strip_workspace_numbers no
    height               30
    font pango:JetBrainsMono Nerd Font 10

    colors {
        background $bg
        statusline $fg
        separator  $green_sel

        # border      background  text
        focused_workspace   $green      $green      $bg
        active_workspace    $green_dim  $bg_panel   $fg
        inactive_workspace  $bg         $bg         $gray
        urgent_workspace    $red        $red        $bg
        binding_mode        $yellow     $yellow     $bg
    }
}
